{
  "status": {
    "description": "Inspect session essentials and paginated document/item summaries. Default 20 documents and 20 items per document. Use offset/limit for documents and item_offset for items; journey.inspect returns stop details. summary=true returns essentials only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "item_offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "summary": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "capabilities": {
    "description": "List supported actions, schemas and operation retention limits.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "operation.status": {
    "description": "Read an operation by its original request ID. Unknown/expired outcomes require inspecting current state before retrying.",
