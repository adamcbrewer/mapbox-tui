  "journey.create": {
    "description": "Create a journey from ordered coordinate stops and mode. Routed modes calculate asynchronously. Does not change camera or selection.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "offline",
            "walking",
            "cycling",
            "driving"
          ]
        }
      },
      "required": [
        "stops",
        "mode"
      ],
      "additionalProperties": false
    }
  },
