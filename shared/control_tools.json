  "camera.set": {
    "description": "Set camera coordinates, zoom or bearing. lat/lon must be supplied together within Mercator range. Uses the viewer animation setting unless animate is supplied. Animated moves return a transition_id and a pending operation, which becomes applied when settled or superseded if redirected.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -85.05112878,
          "maximum": 85.05112878
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "zoom": {
          "type": "number",
          "minimum": -8,
          "maximum": 20
        },
        "bearing": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "animate": {
          "type": "boolean",
          "description": "Override the viewer animation setting for this command."
        }
      },
      "required": [],
      "additionalProperties": false,
      "dependentRequired": {
        "lat": [
          "lon"
        ],
        "lon": [
          "lat"
        ]
      }
    }
  },
  "camera.pan": {
    "description": "Pan by terminal cells as if dragging the map: positive dx drags right, positive dy drags down. Uses the viewer animation setting unless animate is supplied. Animated moves return a transition_id and a pending operation, which becomes applied when settled or superseded if redirected.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dx": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "dy": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "animate": {
          "type": "boolean",
          "description": "Override the viewer animation setting for this command."
        }
      },
      "required": [
        "dx",
        "dy"
      ],
      "additionalProperties": false
    }
  },
