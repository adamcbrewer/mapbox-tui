+++ b/go/import_bom.go
@@ -0,0 +1,14 @@
+package main
+
+import (
+	"io"
+	"os"
+)
+
+func skipXMLBOM(file *os.File, header []byte) error {
+	if len(header) < 3 || string(header[:3]) != "\xef\xbb\xbf" {
+		return nil
+	}
+	_, err := file.Seek(3, io.SeekStart)
+	return err
+}
